{
  "name": "staemme-manager",
  "productName": "Staemme Manager",
  "version": "0.1.0",
  "description": "Lokaler Automatisierer fuer Die Staemme CH",
  "main": "src/main/main.js",
  "author": "buehlmannpa",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "dist:arm": "electron-builder --mac --arm64",
    "dist:intel": "electron-builder --mac --x64",
    "test": "node --test test/logic.test.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ch.local.staemme.manager",
    "productName": "Staemme Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "identity": null,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Staemme Manager"
    }
  }
}
